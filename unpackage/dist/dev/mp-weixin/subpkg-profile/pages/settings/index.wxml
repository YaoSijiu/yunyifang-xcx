<view class="page"><view class="card"><view class="item"><view class="left"><view class="label">访问限制</view><view class="desc">开启后，将记录访客信息，且访客需填写手机号才能访问您的主页</view></view><switch class="small-switch" checked="{{visit.login}}" color="#F37738" data-event-opts="{{[['change',[['handleLoginSwitchChange',['$event']]]]]}}" bindchange="__e"></switch></view><view class="item" style="display:block;"><view class="label" style="margin-bottom:20rpx;">关注服务号获取访客通知</view><official-account data-event-opts="{{[['load',[['onOfficialAccountLoad',['$event']]]],['error',[['onOfficialAccountError',['$event']]]]]}}" bindload="__e" binderror="__e"></official-account></view></view><view class="card-title">专业方向设置</view><view class="card"><view class="item profession-setting"><view class="left"><view class="label">我的专业方向</view><view class="desc">用于任务推荐和个人能力展示，可多选</view><block wx:if="{{$root.g0>0}}"><view class="selected-tags"><block wx:for="{{selectedProfessionNames}}" wx:for-item="name" wx:for-index="__i0__" wx:key="*this"><text class="selected-tag">{{name}}</text></block></view></block><block wx:else><view class="empty-profession">{{''+(professionLoading?'加载中...':'暂未设置')+''}}</view></block></view><view data-event-opts="{{[['tap',[['openProfessionPopup',['$event']]]]]}}" class="edit-btn" bindtap="__e">修改</view></view></view><view class="card-title">访客保存权限</view><view class="card"><view class="item"><view class="left"><view class="label">有水印小图（1200像素宽）</view></view><switch class="small-switch" checked="{{save.watermarkImage}}" data-key="watermarkImage" color="#F37738" data-event-opts="{{[['change',[['handleSaveSwitchChange',['$event']]]]]}}" bindchange="__e"></switch></view><view class="item"><view class="left"><view class="label">无水印小图（1200像素宽）</view></view><switch class="small-switch" checked="{{save.noWatermarkSmall}}" data-key="noWatermarkSmall" color="#F37738" data-event-opts="{{[['change',[['handleSaveSwitchChange',['$event']]]]]}}" bindchange="__e"></switch></view><view class="item"><view class="left"><view class="label">无水印原图</view></view><switch class="small-switch" checked="{{save.noWatermarkOrigin}}" data-key="noWatermarkOrigin" color="#F37738" data-event-opts="{{[['change',[['handleSaveSwitchChange',['$event']]]]]}}" bindchange="__e"></switch></view><view class="item"><view class="left"><view class="label">视频下载</view></view><switch class="small-switch" checked="{{save.video}}" data-key="video" color="#F37738" data-event-opts="{{[['change',[['handleSaveSwitchChange',['$event']]]]]}}" bindchange="__e"></switch></view></view><view class="card-title">下载案例</view><view class="card"><view class="item"><view class="left"><view class="label">作品和作品集下载</view></view><switch class="small-switch" checked="{{save.downloadWorks}}" data-key="downloadWorks" color="#F37738" data-event-opts="{{[['change',[['handleSaveSwitchChange',['$event']]]]]}}" bindchange="__e"></switch></view></view><block wx:if="{{professionPopupVisible}}"><view data-event-opts="{{[['tap',[['closeProfessionPopup',['$event']]]]]}}" class="profession-mask" bindtap="__e"><view data-event-opts="{{[['tap',[['',['$event']]]]]}}" class="profession-popup" catchtap="__e"><view class="popup-header"><view class="popup-title">修改专业方向</view><view data-event-opts="{{[['tap',[['closeProfessionPopup',['$event']]]]]}}" class="popup-close" bindtap="__e">×</view></view><view class="popup-subtitle">请选择您擅长的专业方向，可多选</view><block wx:if="{{$root.g1}}"><view class="category-panel"><scroll-view class="left-scroll" scroll-y="{{true}}"><block wx:for="{{professionTree}}" wx:for-item="item" wx:for-index="__i1__" wx:key="id"><view data-event-opts="{{[['tap',[['selectProfessionParent',['$0'],[[['professionTree','id',item.id]]]]]]]}}" class="{{['left-item',(activeProfessionParentId===item.id)?'active':'']}}" bindtap="__e">{{''+item.categoryName+''}}</view></block></scroll-view><scroll-view class="right-scroll" scroll-y="{{true}}"><view class="chip-wrap"><block wx:for="{{$root.l0}}" wx:for-item="item" wx:for-index="__i2__" wx:key="id"><view data-event-opts="{{[['tap',[['toggleProfession',['$0'],[[['activeProfessionChildren','id',item.$orig.id]]]]]]]}}" class="{{['profession-chip',(item.g2)?'active':'']}}" bindtap="__e">{{''+item.$orig.categoryName+''}}</view></block></view></scroll-view></view></block><block wx:else><view class="category-empty">{{''+(professionLoading?'加载中...':'暂无专业分类')+''}}</view></block><view class="popup-footer"><button data-event-opts="{{[['tap',[['closeProfessionPopup',['$event']]]]]}}" class="cancel-btn" bindtap="__e">取消</button><button class="save-btn" disabled="{{professionSubmitting}}" data-event-opts="{{[['tap',[['saveProfessionSetting',['$event']]]]]}}" bindtap="__e">{{''+(professionSubmitting?'保存中...':'保存')+''}}</button></view></view></view></block></view>