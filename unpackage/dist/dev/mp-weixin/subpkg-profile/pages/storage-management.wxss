
.page.data-v-7def37ae {
	background-color: #f5f5f5;
	min-height: 100vh;
	padding: 40rpx 30rpx;
	box-sizing: border-box;
}
.storage-card.data-v-7def37ae {
	background-color: #ffffff;
	border-radius: 20rpx;
	padding: 30rpx;
	margin-bottom: 30rpx;
	box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
	transition: box-shadow 0.3s ease, -webkit-transform 0.3s ease;
	transition: transform 0.3s ease, box-shadow 0.3s ease;
	transition: transform 0.3s ease, box-shadow 0.3s ease, -webkit-transform 0.3s ease;
}
.storage-card.data-v-7def37ae:active {
	-webkit-transform: translateY(-2rpx);
	        transform: translateY(-2rpx);
	box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.08);
}

/* 卡片头部 */
.card-header.data-v-7def37ae {
	display: flex;
	justify-content: space-between;
	align-items: center;
	margin-bottom: 20rpx;
}
.header-left.data-v-7def37ae {
	display: flex;
	align-items: center;
	gap: 12rpx;
}
.header-icon.data-v-7def37ae {
	width: 32rpx;
	height: 32rpx;
}
.header-title.data-v-7def37ae {
	font-size: 32rpx;
	font-weight: bold;
	color: #333;
}
.header-usage.data-v-7def37ae {
	font-size: 24rpx;
	color: #999;
}

/* 进度条部分 */
.progress-section.data-v-7def37ae {
	margin-bottom: 30rpx;
	text-align: center;
}
.progress-bar.data-v-7def37ae {
	width: 100%;
	height: 12rpx;
	background-color: #f0f0f0;
	border-radius: 6rpx;
	overflow: hidden;
	margin-bottom: 12rpx;
}
.progress-fill.data-v-7def37ae {
	height: 100%;
	border-radius: 6rpx;
	transition: width 0.3s ease;
}
.progress-fill.blue.data-v-7def37ae {
	background-color: rgba(243, 119, 56,0.7);
}
.progress-fill.red.data-v-7def37ae {
	background-color: rgba(255, 0, 0, 0.7);
	box-shadow: 0 0 8rpx rgba(255, 0, 0, 0.3);
}
.progress-text.data-v-7def37ae {
	font-size: 28rpx;
	color: #444444;
	text-align: center;
}
.warning-text.data-v-7def37ae {
	color: #ff0000;
	font-weight: bold;
}

/* 存储详情 */
.storage-details.data-v-7def37ae {
	display: flex;
	justify-content: space-between;
	margin-bottom: 30rpx;
}
.detail-item.data-v-7def37ae {
	flex: 1;
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 8rpx;
}
.detail-label.data-v-7def37ae {
	font-size: 28rpx;
	color: #999;
}
.detail-value.data-v-7def37ae {
	font-size: 28rpx;
	font-weight: bold;
	color: #333;
}
.detail-value.negative.data-v-7def37ae {
	color: #ff6b6b;
}
.detail-link.data-v-7def37ae {
	font-size: 24rpx;
	color: #F37738;
	margin-top: 4rpx;
}

/* 操作按钮 */
.action-btn.data-v-7def37ae {
	width: 50%;
	height: 80rpx;
	line-height: 80rpx;
	text-align: center;
	border-radius: 40rpx;
	color: #ffffff;
	font-size: 30rpx;
	font-weight: 600;
	border: none;
	transition: all 0.3s ease;
	background-color:rgba(243, 119, 56)
}
.action-btn.data-v-7def37ae:active {
	-webkit-transform: translateY(2rpx);
	        transform: translateY(2rpx);
	opacity: 0.9;
}

/* 弹窗样式 */
.modal-overlay.data-v-7def37ae {
	position: fixed;
	top: 0;
	left: 0;
	right: 0;
	bottom: 0;
	background-color: rgba(0, 0, 0, 0.5);
	z-index: 999;
	display: flex;
	flex-direction: column;
	justify-content: flex-end;
}
.modal-content.data-v-7def37ae {
	background: #fff;
	border-radius: 30rpx;
	padding: 10rpx 0 10rpx;
	min-height: 200rpx;
	margin: 10rpx;
}
.wp-handle.data-v-7def37ae {
	width: 100rpx;
	height: 15rpx;
	background: #d3d3d3;
	border-radius: 10rpx;
	margin: 10rpx auto 10rpx;
}
.modal-header.data-v-7def37ae {
	display: flex;
	justify-content: center;
	align-items: center;
	padding: 20rpx;
	border-bottom: 1rpx solid #f0f0f0;
