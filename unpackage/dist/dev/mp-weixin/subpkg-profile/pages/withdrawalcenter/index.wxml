<view class="withdrawal-page data-v-29d061be"><view class="header-panel data-v-29d061be"><view class="nav-row data-v-29d061be"><view data-event-opts="{{[['tap',[['goBack',['$event']]]]]}}" class="back-btn data-v-29d061be" bindtap="__e"><view class="back-icon data-v-29d061be"></view></view><text class="page-title data-v-29d061be">提现中心</text></view></view><scroll-view class="content-scroll data-v-29d061be" scroll-y="{{true}}" lower-threshold="80" data-event-opts="{{[['scrolltolower',[['loadMore',['$event']]]]]}}" bindscrolltolower="__e"><view class="content data-v-29d061be"><view class="settlement-card pending-card data-v-29d061be"><text class="card-label dark-text data-v-29d061be">待结算金额</text><view class="amount-line data-v-29d061be"><text class="amount-number dark-text data-v-29d061be">{{pendingAmount}}</text><text class="amount-unit dark-text data-v-29d061be">元</text></view></view><view class="settlement-card available-card data-v-29d061be"><view class="available-info data-v-29d061be"><text class="card-label light-text data-v-29d061be">可提现到银行卡</text><view class="amount-line data-v-29d061be"><text class="amount-number light-text data-v-29d061be">{{availableAmount}}</text><text class="amount-unit light-text data-v-29d061be">元</text></view></view><view data-event-opts="{{[['tap',[['handleWithdraw',['$event']]]]]}}" class="{{['withdraw-btn','data-v-29d061be',(!canWithdraw||withdrawing)?'disabled':'']}}" bindtap="__e">{{''+(withdrawing?'提现中':'提现')+''}}</view></view><view class="section-title data-v-29d061be">待提现订单</view><view class="order-list data-v-29d061be"><block wx:for="{{$root.l0}}" wx:for-item="item" wx:for-index="index"><view class="order-card data-v-29d061be" data-order-no="{{item.$orig.orderNo}}" data-withdraw-id="{{item.$orig.withdrawId}}" data-status="{{item.$orig.status}}" data-amount="{{item.$orig.amount}}" data-event-opts="{{[['tap',[['handleOrderClick',['$event']]]]]}}" catchtap="__e"><view class="order-main data-v-29d061be"><view class="order-info data-v-29d061be"><text class="order-no data-v-29d061be">{{"订单号："+item.$orig.orderNo}}</text><text class="order-date data-v-29d061be">{{item.$orig.date}}</text></view><view class="order-side data-v-29d061be"><view class="amount-status data-v-29d061be"><text class="{{['order-amount','data-v-29d061be',item.$orig.displayAmount>=0?'amount-plus':'amount-minus']}}">{{''+item.m0+''}}</text><text class="order-status data-v-29d061be">{{item.$orig.statusText}}</text></view><view class="arrow-box data-v-29d061be"><view class="arrow-icon data-v-29d061be"></view></view></view></view></view></block><block wx:if="{{$root.g0}}"><view class="empty-state data-v-29d061be">暂无提现订单</view></block><block wx:if="{{loading}}"><view class="list-tip data-v-29d061be">加载中...</view></block><block wx:else><block wx:if="{{$root.g1}}"><view class="list-tip data-v-29d061be">没有更多了</view></block></block></view></view></scroll-view></view>