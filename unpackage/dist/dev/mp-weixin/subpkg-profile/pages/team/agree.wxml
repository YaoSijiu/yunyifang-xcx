<view class="container"><view class="card"><block wx:if="{{inviterInfo.avatarUrl||inviterInfo.avatar}}"><image class="logo" src="{{$root.m0}}"></image></block><block wx:else><image class="logo" src="https://yunyifang-test.oss-cn-beijing.aliyuncs.com/static/logo.png"></image></block><block wx:if="{{inviterInfo.nickName}}"><view class="title">{{inviterInfo.nickName+" 邀请你加入团队"}}</view></block><block wx:else><view class="title">邀请加入团队</view></block><block wx:if="{{!isLoggedIn}}"><block><view class="desc">您需要先登录才能加入团队</view><button data-event-opts="{{[['tap',[['goToLogin',['$event']]]]]}}" class="btn btn-primary" bindtap="__e">立即登录</button></block></block><block wx:else><block><view class="desc">您收到加入团队的邀请</view><view class="actions"><button data-event-opts="{{[['tap',[['agreeToJoin',['$event']]]]]}}" class="btn btn-primary" bindtap="__e">同意加入</button><button data-event-opts="{{[['tap',[['goHome',['$event']]]]]}}" class="btn btn-outline" bindtap="__e">返回首页</button></view></block></block></view></view>