.favorite-page.data-v-3e3afc0e {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f7f7f7;
  color: #000000;
}
button.data-v-3e3afc0e {
  margin: 0;
  padding: 0;
  background: transparent;
  line-height: normal;
}
button.data-v-3e3afc0e::after {
  border: 0;
}
.list-scroll.data-v-3e3afc0e {
  flex: 1;
  height: 0;
  background: #f7f7f7;
}
.list-body.data-v-3e3afc0e {
  min-height: 1080rpx;
  padding: 26rpx 30rpx 48rpx;
  box-sizing: border-box;
}
.state-block.data-v-3e3afc0e,
.empty-card.data-v-3e3afc0e {
  min-height: 600rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #999999;
}
.empty-card.data-v-3e3afc0e {
  min-height: 520rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
}
.empty-icon.data-v-3e3afc0e {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #fff1e9;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}
.empty-icon text.data-v-3e3afc0e {
  font-size: 72rpx;
  line-height: 72rpx;
  color: #f37738;
}
.empty-title.data-v-3e3afc0e {
  font-size: 32rpx;
  line-height: 45rpx;
  color: #333333;
  font-weight: 600;
}
.empty-desc.data-v-3e3afc0e {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 34rpx;
  color: #999999;
}
.retry-btn.data-v-3e3afc0e {
  width: 180rpx;
  height: 64rpx;
  margin-top: 24rpx;
  border-radius: 32rpx;
  background: #f37738;
  color: #ffffff;
  font-size: 26rpx;
  line-height: 64rpx;
}
.showcase-card.data-v-3e3afc0e {
  position: relative;
  width: 690rpx;
  height: 220rpx;
  margin-bottom: 26rpx;
  border-radius: 16rpx;
  background: #ffffff;
  overflow: hidden;
}
.cover-image.data-v-3e3afc0e {
  position: absolute;
  left: 28rpx;
  top: 28rpx;
  width: 164rpx;
  height: 164rpx;
  border-radius: 16rpx;
  background: #f0f0f0;
}
.card-info.data-v-3e3afc0e {
  position: absolute;
  left: 214rpx;
  top: 32rpx;
  width: 300rpx;
}
.card-title.data-v-3e3afc0e {
  display: block;
  font-size: 32rpx;
  line-height: 45rpx;
  color: #000000;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.sales-line.data-v-3e3afc0e {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 34rpx;
  color: rgba(0, 0, 0, 0.4);
  white-space: nowrap;
}
.sales-line.second.data-v-3e3afc0e {
  margin-top: 4rpx;
}
.price-text.data-v-3e3afc0e {
  position: absolute;
  right: 28rpx;
  top: 56rpx;
  max-width: 170rpx;
  font-size: 34rpx;
  line-height: 48rpx;
  color: #f37738;
  text-align: right;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.cancel-favorite-btn.data-v-3e3afc0e {
  position: absolute;
  right: 28rpx;
  bottom: 28rpx;
  width: 148rpx;
  height: 48rpx;
  border: 1rpx solid #d4d4d4;
  border-radius: 28rpx;
  color: #979797;
  background: #ffffff;
  font-size: 24rpx;
  line-height: 48rpx;
}
.cancel-favorite-btn[disabled].data-v-3e3afc0e {
  opacity: 0.6;
}
.load-more-text.data-v-3e3afc0e {
  padding: 10rpx 0 40rpx;
  text-align: center;
  font-size: 24rpx;
  color: #999999;
}
