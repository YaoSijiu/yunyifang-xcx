.status-bar.data-v-0e80c22d {
	width: 100%;
	background: #ffffff;
}
/* 标题栏 */
.title-bar.data-v-0e80c22d {
	display: flex;
	align-items: center;
	justify-content: space-between;
	height: 44px;
	padding: 0 15rpx;
	background: #ffffff;
	position: relative;
}
.title-bar.fixed.data-v-0e80c22d {
	position: fixed;
	top: 0;
	left: 0;
	right: 0;
	z-index: 999;
	height: auto;
}
.fixed-placeholder.data-v-0e80c22d {
	width: 100%;
}
.back-button.data-v-0e80c22d {
	width: 44px;
	height: 44px;
	display: flex;
	align-items: center;
	justify-content: center;
	flex-shrink: 0;
}
.back-arrow.data-v-0e80c22d {
	width: 8px;
	height: 8px;
	border-left: 2.5px solid #333333;
	border-bottom: 2.5px solid #333333;
	-webkit-transform: rotate(45deg);
	        transform: rotate(45deg);
	margin-left: 2px;
}
.title-text.data-v-0e80c22d {
	position: absolute;
	left: 50%;
	-webkit-transform: translateX(-50%);
	        transform: translateX(-50%);
	font-size: 38rpx;
	font-weight: normal;
	color: #333333;
	text-align: center;
	max-width: 400rpx;
	overflow: hidden;
	white-space: nowrap;
	text-overflow: ellipsis;
}
.placeholder.data-v-0e80c22d {
	width: 44px;
	height: 44px;
	flex-shrink: 0;
}
.right-slot.data-v-0e80c22d {
	flex-shrink: 0;
	display: flex;
	align-items: center;
}

