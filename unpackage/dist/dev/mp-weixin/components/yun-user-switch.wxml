<view class="switch-container data-v-285d9510"><view data-event-opts="{{[['tap',[['closeModal',['$event']]]]]}}" class="mask data-v-285d9510" bindtap="__e"></view><view class="modal-content data-v-285d9510"><view class="modal-header data-v-285d9510"><text class="modal-title data-v-285d9510">点击切换账号</text></view><view class="account-list data-v-285d9510"><block wx:if="{{teamInfo}}"><view data-event-opts="{{[['tap',[['selectAccount',['team']]]]]}}" class="{{['account-item','data-v-285d9510',(selectedAccount==='team')?'active':'',(teamInfo.status===1)?'expired':'']}}" bindtap="__e"><view class="account-avatar data-v-285d9510"><image class="avatar-image data-v-285d9510" src="{{$root.m0}}"></image></view><view class="account-info data-v-285d9510"><text class="account-name data-v-285d9510">{{teamInfo.nickName||'团队账号'}}</text><text class="account-tag data-v-285d9510">{{teamInfo.status===1?'(团长会员到期)':'(团队)'}}</text></view><block wx:if="{{selectedAccount==='team'&&teamInfo.status!==1}}"><view class="checkmark data-v-285d9510"><image class="checkmark-text data-v-285d9510" src="/static/common/切换账号选中.png"></image></view></block></view></block><view data-event-opts="{{[['tap',[['selectAccount',['personal']]]]]}}" class="{{['account-item','data-v-285d9510',(selectedAccount==='personal')?'active':'']}}" bindtap="__e"><view class="account-avatar data-v-285d9510"><image class="avatar-image data-v-285d9510" src="{{$root.m1}}"></image></view><view class="account-info data-v-285d9510"><text class="account-name data-v-285d9510">{{userInfo.nickName||'未命名'}}</text><text class="account-tag data-v-285d9510">(我的)</text></view><block wx:if="{{selectedAccount==='personal'}}"><view class="checkmark data-v-285d9510"><image class="checkmark-text data-v-285d9510" src="/static/common/切换账号选中.png"></image></view></block></view></view></view></view>