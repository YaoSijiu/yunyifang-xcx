<block wx:if="{{isVisible}}"><view class="storage-warning-container data-v-2b41f8e4"><view data-event-opts="{{[['tap',[['handleCancel',['$event']]]]]}}" class="modal-overlay data-v-2b41f8e4" bindtap="__e"></view><view class="modal-content data-v-2b41f8e4"><view class="modal-title data-v-2b41f8e4">{{modalData.title}}</view><view class="modal-text data-v-2b41f8e4">{{modalData.content}}</view><block wx:if="{{$root.g0}}"><view class="expand-options data-v-2b41f8e4"><view class="flow-info-card flow-description data-v-2b41f8e4"><view class="flow-info-title data-v-2b41f8e4">计费说明</view><view class="flow-info-price data-v-2b41f8e4">按0.2元/GB/月x会员剩余有效月计算</view><view class="flow-info-text data-v-2b41f8e4">(不足31天按一个月计算)</view></view><block wx:for="{{spaceOptions}}" wx:for-item="item" wx:for-index="__i0__" wx:key="id"><view data-event-opts="{{[['tap',[['selectOption',['$0'],[[['spaceOptions','id',item.id]]]]]]]}}" class="{{['option-item','expand','data-v-2b41f8e4',(selectedOption&&selectedOption.id===item.id)?'selected':'']}}" bindtap="__e"><text class="option-size data-v-2b41f8e4">{{item.space+"GB"}}</text><text class="option-desc data-v-2b41f8e4">{{item.month+"个月"}}</text><text class="option-price data-v-2b41f8e4">{{"¥"+item.price}}</text></view></block></view></block><block wx:if="{{$root.g1}}"><view class="flow-options data-v-2b41f8e4"><block wx:for="{{$root.l0}}" wx:for-item="item" wx:for-index="__i1__" wx:key="id"><view data-event-opts="{{[['tap',[['selectOption',['$0'],[[['spaceOptions','id',item.$orig.id]]]]]]]}}" class="{{['option-item','flow','data-v-2b41f8e4',(selectedOption&&selectedOption.id===item.$orig.id)?'selected':'']}}" bindtap="__e"><view class="option-content data-v-2b41f8e4"><view class="option-main data-v-2b41f8e4"><text class="option-size data-v-2b41f8e4">{{item.$orig.space+" GB"}}</text><text class="option-unit-price data-v-2b41f8e4">{{"¥"+item.g2+" / GB"}}</text></view><text class="option-price data-v-2b41f8e4">{{"¥"+item.$orig.price}}</text></view><text class="option-desc data-v-2b41f8e4">{{"有效期："+(item.$orig.expireDays||365)+"天"}}</text><block wx:if="{{selectedOption&&selectedOption.id===item.$orig.id}}"><view class="option-checkbox data-v-2b41f8e4"><image class="checkbox-icon data-v-2b41f8e4" src="/static/common/切换账号选中.png"></image></view></block></view></block></view></block><view class="modal-buttons data-v-2b41f8e4"><button data-event-opts="{{[['tap',[['handleCancel',['$event']]]]]}}" class="btn btn-cancel data-v-2b41f8e4" bindtap="__e">{{modalData.cancelText||cancelText}}</button><button data-event-opts="{{[['tap',[['handleConfirm',['$event']]]]]}}" class="btn btn-confirm data-v-2b41f8e4" bindtap="__e">{{modalData.confirmText||confirmText}}</button></view></view></view></block>