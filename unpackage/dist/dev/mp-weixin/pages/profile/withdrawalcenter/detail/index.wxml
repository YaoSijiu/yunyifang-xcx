<view class="detail-page data-v-9c4f43ac"><view class="header-panel data-v-9c4f43ac"><view class="nav-row data-v-9c4f43ac"><view data-event-opts="{{[['tap',[['goBack',['$event']]]]]}}" class="back-btn data-v-9c4f43ac" bindtap="__e"><view class="back-icon data-v-9c4f43ac"></view></view><text class="page-title data-v-9c4f43ac">订单详情</text></view></view><scroll-view class="content-scroll data-v-9c4f43ac" scroll-y="{{true}}"><block wx:if="{{loading}}"><view class="state-block data-v-9c4f43ac">加载中...</view></block><block wx:else><block wx:if="{{loadError}}"><view class="state-block data-v-9c4f43ac"><text class="data-v-9c4f43ac">{{loadError}}</text><view data-event-opts="{{[['tap',[['loadTaskDetail',['$event']]]]]}}" class="retry-btn data-v-9c4f43ac" bindtap="__e">重新加载</view></view></block><block wx:else><view class="content data-v-9c4f43ac"><view class="hero-card data-v-9c4f43ac"><view class="poster-area data-v-9c4f43ac"><block wx:if="{{$root.g0>0}}"><swiper class="poster-swiper data-v-9c4f43ac" indicator-dots="{{false}}" circular="{{true}}" data-event-opts="{{[['change',[['handlePosterChange',['$event']]]]]}}" bindchange="__e"><block wx:for="{{imageUrls}}" wx:for-item="image" wx:for-index="index"><swiper-item class="data-v-9c4f43ac"><image class="poster-image data-v-9c4f43ac" src="{{image}}" mode="aspectFill" data-event-opts="{{[['tap',[['previewImage',[index]]]]]}}" bindtap="__e"></image></swiper-item></block></swiper></block><block wx:else><view class="empty-poster data-v-9c4f43ac">暂无封面</view></block><block wx:if="{{$root.g1>0}}"><view class="poster-count data-v-9c4f43ac">{{currentPosterIndex+1+"/"+$root.g2}}</view></block></view><text class="task-title data-v-9c4f43ac">{{detail.taskTitleSnapshot||'暂无标题'}}</text><text class="task-desc data-v-9c4f43ac">{{detail.taskDescSnapshot||'暂无描述'}}</text></view><view class="requirement-card data-v-9c4f43ac"><view class="requirement-section data-v-9c4f43ac"><view class="section-title data-v-9c4f43ac">专业类型</view><block wx:if="{{$roo