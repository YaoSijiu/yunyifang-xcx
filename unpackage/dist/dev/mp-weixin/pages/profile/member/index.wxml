urrentLevel)?'disabled-btn':'']}}" disabled="{{item.isDisabled&&!item.isCurrentLevel||item.isCurrentLevel&&item.canRenew!==1}}" data-item="{{item}}" data-event-opts="{{[['tap',[['handleBuyPlan',['$event']]]]]}}" bindtap="__e">{{''+(item.isCurrentLevel?item.canRenew===1?'立即续费':'当前使用':item.isDisabled?'不可升级':'立即开通')+''}}</button></view></block></view><view class="section-block faq-section data-v-1d238a3c"><view class="section-title data-v-1d238a3c">常见问题</view><block wx:for="{{faqList}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="faq-item data-v-1d238a3c"><view class="faq-question-row data-v-1d238a3c"><text class="q data-v-1d238a3c">{{index+1+". "+item.question}}</text></view><view class="a data-v-1d238a3c">{{''+item.answer+''}}</view></view></block></view></view></block><block wx:else><block wx:if="{{memberInfo&&memberInfo.status==='expired'}}"><view class="data-v-1d238a3c"><view class="expired-detail-card data-v-1d238a3c"><view class="card-header data-v-1d238a3c"><text class="card-title data-v-1d238a3c">体验版</text><text class="expired-badge data-v-1d238a3c">● 已结束</text></view><view class="detail-list data-v-1d238a3c"><view class="detail-item data-v-1d238a3c"><text class="label data-v-1d238a3c">📦 作品空间：</text><text class="value data-v-1d238a3c">10G</text></view><view class="detail-item data-v-1d238a3c"><text class="label data-v-1d238a3c">🈚 会员免费流量：</text><text class="value data-v-1d238a3c">10G</text></view><view class="detail-item data-v-1d238a3c"><text class="label data-v-1d238a3c">👤 团队视位：</text><text class="value data-v-1d238a3c">2个</text></view><view class="detail-divider data-v-1d238a3c"></view><view class="detail-item data-v-1d238a3c"><text class="label data-v-1d238a3c">📅 起始日期：</text><text class="value data-v-1d238a3c">2025/12/04</text></view><view class="detail-item data-v-1d238a3c"><text class="label data-v-1d238a3c">📅 结束日期：</text><text class="value data-v-1d238a3c">2026/12/04</text></view></view></view></view></block></block></view>