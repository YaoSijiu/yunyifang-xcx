/* 可排序项 */
.sortable-item.data-v-410684fd {
  margin-bottom: 14rpx;
  border-radius: 18rpx;
  background: #fff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
  position: relative;
  transition: box-shadow 0.18s ease, opacity 0.12s ease, -webkit-transform 0.12s ease;
  transition: transform 0.12s ease, box-shadow 0.18s ease, opacity 0.12s ease;
  transition: transform 0.12s ease, box-shadow 0.18s ease, opacity 0.12s ease, -webkit-transform 0.12s ease;
}
.sortable-item.dragging.data-v-410684fd {
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.15);
  z-index: 1000;
}
.sortable-item.drag-placeholder.data-v-410684fd {
  opacity: 0;
}
.drag-floating.data-v-410684fd {
  position: fixed;
  z-index: 9999;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 18rpx 40rpx rgba(0, 0, 0, 0.18);
  overflow: hidden;
  pointer-events: none;
  opacity: 0.96;
  -webkit-transform: scale(1.02);
          transform: scale(1.02);
}
/* 拖拽手柄 */
.drag-handle.data-v-410684fd {
  position: absolute;
  left: 20rpx;
  top: 50%;
  -webkit-transform: translateY(-50%);
          transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  width: 40rpx;
  height: 80rpx;
  cursor: grab;
}
